// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/universal
{
	"name": "ADVT Devlopment Container v1.0.4",
	"initializeCommand": "bash .devcontainer/initializeCreateCommand.sh",
	"postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
	"privileged": true,
    "remoteUser": "advt_user",
    "containerUser": "advt_user",
	"build": {
		"dockerfile": "Dockerfile"
	},

	"customizations": {
		"vscode": {
            "extensions": [
				"ms-azuretools.vscode-containers",
				"ms-vscode-remote.remote-containers",
                "bierner.docs-view",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "rodolphebarbanneau.python-docstring-highlighter",
                "yzhang.markdown-all-in-one",
                "davidanson.vscode-markdownlint",
				"github.vscode-github-actions",
				"streetsidesoftware.code-spell-checker",
				// PX4 extensions vvv
				"chiehyu.vscode-astyle",
				"dan-c-underwood.arm",
				"editorconfig.editorconfig",
				"fredericbonnet.cmake-test-adapter",
				"github.vscode-pull-request-github",
				"marus25.cortex-debug",
				"ms-azuretools.vscode-docker",
				"ms-iot.vscode-ros",
				"ms-python.python",
				"ms-vscode.cmake-tools",
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"redhat.vscode-yaml",
				"streetsidesoftware.code-spell-checker",
				"twxs.cmake",
				"uavcan.dsdl",
				"wholroyd.jinja",
				"zixuanwang.linkerscript",
				"ms-vscode.makefile-tools"
				// PX4 extensions ^^^
			]
		}
	},

	// GPU Forwarding stuff
	"mounts": [
		"source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
		"source=/usr/lib/wsl/lib,target=/usr/lib/wsl/lib,type=bind,readonly",
		"source=/usr/lib/wsl/drivers,target=/usr/lib/wsl/drivers,type=bind,readonly"
	],

	"containerEnv": {	
		"DISPLAY": "${localEnv:DISPLAY}",
		"GALLIUM_DRIVER": "d3d12",							//Drivers cannot be localEnv
		"MESA_D3D12_DEFAULT_ADAPTER_NAME": "NVIDIA",		//might we need?: "NVIDIA_DRIVER_CAPABILITIES": "${localEnv:NVIDIA}",
		"LD_LIBRARY_PATH": "/usr/lib/wsl/lib"				// ^ probably not
	},
	"runArgs": [
               "--gpus", "all",			//will break on non-NVIDIA machines; need to figure out a way to auto-pick different installation args depending on machine
               "--device", "/dev/dxg"	// 
       ]
}
